{
  "name": "skylink-api",
  "version": "0.1.1",
  "description": "Official TypeScript/JavaScript SDK for the SkyLink API — aviation data: live ADS-B, weather, airports, charts, NOTAMs, flight status and more.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./units": {
      "import": {
        "types": "./dist/units.d.ts",
        "default": "./dist/units.js"
      },
      "require": {
        "types": "./dist/units.d.cts",
        "default": "./dist/units.cjs"
      }
    },
    "./spatial": {
      "import": {
        "types": "./dist/spatial.d.ts",
        "default": "./dist/spatial.js"
      },
      "require": {
        "types": "./dist/spatial.d.cts",
        "default": "./dist/spatial.cjs"
      }
    },
    "./idents": {
      "import": {
        "types": "./dist/idents.d.ts",
        "default": "./dist/idents.js"
      },
      "require": {
        "types": "./dist/idents.d.cts",
        "default": "./dist/idents.cjs"
      }
    },
    "./weather": {
      "import": {
        "types": "./dist/weather.d.ts",
        "default": "./dist/weather.js"
      },
      "require": {
        "types": "./dist/weather.d.cts",
        "default": "./dist/weather.cjs"
      }
    },
    "./geojson": {
      "import": {
        "types": "./dist/geojson.d.ts",
        "default": "./dist/geojson.js"
      },
      "require": {
        "types": "./dist/geojson.d.cts",
        "default": "./dist/geojson.cjs"
      }
    },
    "./batch": {
      "import": {
        "types": "./dist/batch.d.ts",
        "default": "./dist/batch.js"
      },
      "require": {
        "types": "./dist/batch.d.cts",
        "default": "./dist/batch.cjs"
      }
    },
    "./sentinels": {
      "import": {
        "types": "./dist/sentinels.d.ts",
        "default": "./dist/sentinels.js"
      },
      "require": {
        "types": "./dist/sentinels.d.cts",
        "default": "./dist/sentinels.cjs"
      }
    },
    "./cache": {
      "import": {
        "types": "./dist/cache.d.ts",
        "default": "./dist/cache.js"
      },
      "require": {
        "types": "./dist/cache.d.cts",
        "default": "./dist/cache.cjs"
      }
    },
    "./csv": {
      "import": {
        "types": "./dist/csv.d.ts",
        "default": "./dist/csv.js"
      },
      "require": {
        "types": "./dist/csv.d.cts",
        "default": "./dist/csv.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests examples",
    "lint:fix": "biome check --write src tests examples",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "skylink",
    "aviation",
    "adsb",
    "metar",
    "taf",
    "notam",
    "flight-tracking",
    "airports",
    "aviation-weather",
    "api-client",
    "sdk"
  ],
  "author": "SkyLink API <hello@skylinkapi.com>",
  "license": "MIT",
  "homepage": "https://skylinkapi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkyLink-API/SkyLink-API-TypeScript-SDK.git"
  },
  "bugs": {
    "url": "https://github.com/SkyLink-API/SkyLink-API-TypeScript-SDK/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "undici": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
